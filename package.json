{
  "name": "character-viewer-web",
  "private": true,
  "version": "0.4.1",
  "description": "Static web viewer for OpenKakutou MUGEN/Ikemen GO character files — sprites, palettes, animations, and an in-game preview mode.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "wasm:download": "node scripts/download-wasm.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@openkakutou/web-ui-kit": "^0.3.0"
  }
}
